# E2E Test Environment Variables
# Copy this file to .env and fill in the values

# Magic-link-configured project ID
ZD_PROJECT_ID=

# Plain-OTP project ID (no magic_link_template)
ZD_OTP_PROJECT_ID=

# Mailosaur, the temporary inbox the OTP and magic-link suites read from.
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=

# --- Server Wallets  for testing ---

# Wallet set sub-organization id, from registering the set in the dashboard.
ZD_SW_ORGANIZATION_ID=

# The project the wallet set belongs to. Its ACL must allowlist ZD_SW_ORIGIN.
ZD_SW_PROJECT_ID=

# Agent key with all roles set: CREATE, SIGN and READ
ZD_SW_AGENT_PRIVATE_KEY=

# The address every signing case signs as.
ZD_SW_ADDRESS=

# The wallet that address belongs to
ZD_SW_WALLET_ID=

# An origin on the project's ACL allowlist. Node sends no Origin of its own, and without
# one the KMS answers `400 invalid_request / acl check failed` on every call.
ZD_SW_ORIGIN=

ZD_SW_PROXY_BASE_URL=

# Three agent keys holding exactly one role each, for the role suite.
ZD_SW_KEY_CREATE=
ZD_SW_KEY_SIGN=
ZD_SW_KEY_READ=
