# E2E Test Environment Variables
# Copy this file to .env and fill in the values

# Magic-link-configured project ID
ZD_PROJECT_ID=

# Plain-OTP project ID (no magic_link_template)
ZD_OTP_PROJECT_ID=

# Mailosaur, the temporary inbox the OTP and magic-link suites read from.
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=
