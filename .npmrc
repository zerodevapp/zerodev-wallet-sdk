# Security configurations
prefer-offline=true
package-import-method=hardlink

# Audit configuration
audit-level=moderate

# Security: Enable strict SSL and registry verification
strict-ssl=true

# Fetch configuration
fetch-timeout=60000
fetch-retries=2

# Additional security settings
ignore-scripts=false
fund=false

# Package age restriction is configured in pnpm-workspace.yaml

link-workspace-packages=deep

# Refuse to install or run scripts on a Node outside engines.node
# (CVE-2026-111497 floor). CI enforces the same thing: every job installs the
# .nvmrc Node and then runs pnpm install under this flag.
# Note: with this flag pnpm also hard-fails on any dependency whose own
# engines.node excludes the running Node. If ERR_PNPM_UNSUPPORTED_ENGINE
# appears after a dependency bump, that package may need an override or a
# different Node; the error text only names Node.
engine-strict=true
