# Port the values from apps/zerodev-signer-demo/.env.local.
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
NEXT_PUBLIC_KMS_PROXY_BASE_URL=

# Required for the Solana WalletConnect row. Unset and no WalletConnect
# connector registers, so `kit.solana.walletConnect` is false and the
# SolanaWalletConnect unit hides itself. Installed wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional RPC overrides; viem's public endpoints are used when blank.
NEXT_PUBLIC_ARB_SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
