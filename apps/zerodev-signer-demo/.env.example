NEXT_PUBLIC_APP_URL=http://localhost:3000
# Chain RPC URLs. Leave blank and viem falls back to each chain's public
# endpoint, which is rate-limited: reconnect on page load builds the kernel
# account over RPC, so a throttled request means a long "Reconnecting..."
# spinner (viem retries 3x with a 10s timeout). Use a provider URL
# (Alchemy, Infura, dRPC, ...) for anything beyond a quick look.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARB_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
